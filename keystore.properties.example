# Copie para keystore.properties (que fica fora do git) e preencha.
# Gere a chave uma vez com:
#   keytool -genkeypair -v -keystore keystore/rivais-release.jks -alias rivais -keyalg RSA -keysize 4096 -validity 10000
# Guarde o .jks e as senhas: um APK assinado com outra chave obriga a desinstalar o app (e perder os dados locais).
storeFile=keystore/rivais-release.jks
storePassword=
keyAlias=rivais
keyPassword=
